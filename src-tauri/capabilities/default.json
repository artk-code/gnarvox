{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "gnarvox Studio: native save dialogs plus read/write access to the app's model store under appData. Paths picked via the dialog plugin are added to the fs scope at runtime.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "opener:default"
  ]
}
