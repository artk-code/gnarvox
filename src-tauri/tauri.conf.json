{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gnarvox-studio",
  "version": "0.3.0",
  "identifier": "com.gnarvox.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "gnarvox Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "Music",
    "shortDescription": "Local lesson-narration studio",
    "longDescription": "gnarvox Studio turns lesson scripts into narrated audio, fully locally: normalize, chunk, generate with a local TTS engine (Kokoro-82M) or a synthetic demo voice, audition, and export WAV + provenance manifest. No API keys, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
